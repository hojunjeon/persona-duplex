# Copy to .env. Never commit real API keys.

# OpenAI-compatible LLM. Default: Ollama on the host.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:1.7b
LLM_TEMPERATURE=0.75
LLM_MAX_TOKENS=260
# For Qwen thinking models you may set provider-specific options here.
LLM_EXTRA_BODY_JSON={}

# Local Ollama launcher settings. The Windows launcher starts Ollama and pulls this model.
OLLAMA_PORT=11434

# Public access for the local UI. Tailscale Funnel keeps the origin on 127.0.0.1:8080.
# Use `off` to disable external access; `localtunnel`/`quick` are optional fallbacks.
# If the selected tunnel cannot pass /api/health, the launcher keeps the local UI running.
PUBLIC_TUNNEL=tailscale

# Optional paid low-latency STT modes. Keep secrets only in .env.
ELEVENLABS_API_KEY=
SONIOX_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Persona and turn-taking.
DEFAULT_PERSONA=default
BARGE_IN_CONFIRM_MS=420
SHORT_BACKCHANNEL_MAX_MS=850
EMPTY_BACKCHANNEL_MAX_MS=320
BACKCHANNEL_AFTER_MS=1900
BACKCHANNEL_COOLDOWN_MS=3300
BACKCHANNEL_ENABLED=true

# TTS fidelity/latency trade-off. 2 is faster/more granular; 4 is safer.
TTS_CHUNK_SIZE=4
TTS_BACKEND=auto

# Local ASR defaults. The launcher overrides these for balanced/accuracy modes.
ASR_MODEL_ID=Qwen/Qwen3-ASR-0.6B
ASR_GPU_MEMORY_UTILIZATION=0.75
ASR_CHUNK_SIZE_SEC=0.40
ASR_MAX_MODEL_LEN=2048
ASR_ENFORCE_EAGER=true

# Optional benchmark-only settings.
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# Browser VAD / full-duplex timing. Defaults suit a headset in a quiet room.
PRE_ROLL_MS=440
VAD_START_FRAMES=3
VAD_END_MS_ASSISTANT=300
VAD_END_MS_IDLE=520
VAD_THRESHOLD_MIN=0.012
VAD_NOISE_MULTIPLIER_ASSISTANT=3.4
VAD_NOISE_MULTIPLIER_IDLE=2.7
